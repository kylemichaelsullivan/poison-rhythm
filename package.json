{
	"name": "poison-rhythm",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "bun@1.1.0",
	"scripts": {
		"build": "tsc -b && vite build",
		"dev": "vite",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"ci": "biome ci . && bun test src/lib/__tests__",
		"preview": "vite preview",
		"test": "bun test src/lib/__tests__",
		"test:unit": "bun test src/lib/__tests__",
		"test:integration": "bun test src/lib/__tests__/integration",
		"test:e2e": "playwright test",
		"test:a11y": "playwright test e2e/a11y.spec.ts",
		"test:all": "biome ci . && bun test src/lib/__tests__ && playwright test",
		"printables:student-record": "bun run scripts/generate-student-record-pdf.ts"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "2.3.14",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.13",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"postcss": "^8.5.19",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"vite": "^7.3.6",
		"vite-plugin-svgr": "^5.2.0"
	},
	"overrides": {
		"@babel/core": "^7.29.6",
		"esbuild": "^0.28.1",
		"js-yaml": "^4.2.0",
		"picomatch": "^4.0.4",
		"rollup": "^4.59.0"
	}
}
